[Unit]
Description=Robot vision: localization daemon (shared memory -> NATS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson/projects/robot-vision
Environment=PYTHONPATH=/home/jetson/projects/robot-vision
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m module2_localization.service --shm
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
