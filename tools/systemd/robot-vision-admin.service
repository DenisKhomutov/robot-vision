[Unit]
Description=Robot vision: localization web admin
After=network-online.target robot-vision-localization.service
Wants=network-online.target

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson/projects/robot-vision
Environment=PYTHONPATH=/home/jetson/projects/robot-vision
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m module2_localization.admin --bind 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
