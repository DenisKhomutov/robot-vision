# ── Qdrant (модуль 2, локализация — легаси/резерв) ─────────────────────────
# В docker compose обращение к сервису идёт по имени контейнера → "qdrant".
# Для standalone-запуска (uv run uvicorn ...) поставь "localhost".
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Интеграция с модулем управления робота ────────────────────────────────
# URL модуля управления (куда шлём результат). Пусто → интеграция отключена.
CONTROL_URL=
# URL сервиса камер (capture-and-send). Пусто → триггер камер отключён.
CAMERA_URL=
# Токен для заголовка X-Capture-Token при дёрганье камер.
CAMERA_TOKEN=
